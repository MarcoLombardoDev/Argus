# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────
# SENSITIVE — never commit
# Deny-by-default: the whole runtime data directory is excluded, so a new
# artefact appearing there can never be committed by accident.
# ─────────────────────────────────────────────────────────────

# Secrets store, in every variant (.env.local, .env.bak, env.txt, ...)
.env
.env.*
*.env
env.txt
!.env.example
!.env.template

# User configuration containing API keys — the *template* stays tracked
config/settings.json
config/settings*.json
!config/settings.template.json
settings.json

# All runtime output: historical caches, forecasts, AI sessions,
# order audit trail, auto-trading logs.
data/

# Common credential filenames
credentials*
secrets*
keys.txt
*.pem
*.p12
*.pfx
*.key
!*-public.key
id_rsa*
*.keystore

# Private notes and backups
info-private.txt
*-private.*
*.bak
*.backup
*.orig

# HuggingFace / model cache
.cache/
huggingface/

# Scratch / temp files
scratch_*.py
tmp/
*.tmp

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Logs
*.log
